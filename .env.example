# Copy to .env.local and fill in. Nothing here is required for local dev:
# with no DATABASE_URL Loxe uses embedded Postgres (PGlite) in .data/, and with no
# CLERK_SECRET_KEY it uses dev sign-in (any email). Integrations show "not configured".

PORT=3000
LOXE_BASE_URL=http://localhost:3000

# Database (Supabase Postgres connection string). Unset = embedded PGlite.
DATABASE_URL=

# Auth (Clerk). Unset outside production = dev sign-in.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Ledger head signing key (Ed25519 PKCS#8 PEM, \n-escaped). Unset = generated once, kept in DB.
LOXE_SIGNING_KEY=

# Sponsors
MARITIME_API_KEY=
MARITIME_WEBHOOK_SECRET=
SUPERMEMORY_API_KEY=
KEIKI_API_KEY=

# Sentinel: bearer secret Maritime's schedule uses for POST /sentinel/tick
LOXE_SCHEDULE_SECRET=

# Allow probing localhost/private IPs (on by default outside production; needed for the demo target)
LOXE_ALLOW_PRIVATE_TARGETS=
